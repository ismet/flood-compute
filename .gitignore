env/

data/dem/cache/
data/corine/cache/
data/projects/
data/raster/
# akarsu.sqlite artık depoda: geometri delta+varint+zlib ile 68 MB'a indi ve
# GitHub'ın 100 MB sınırının altına girdi, böylece canlıda da katman geliyor.
# Dönüştürmeden kalan yedek kopya girmesin:
data/akarsu/*.eski

# data/stations/DMİ.kmz is the canonical copy; root is a local fallback
/DMİ.kmz
# data/regions/YZD_ALANLAR.kmz asıl kopya; kökteki bayt bayt aynısı
/YZD_ALANLAR.kmz

.commandcode/
/aster30m.vrt
data/dem/aster30m.vrt
data/dem/aster30m/
data/DMİ_yedek.kmz

# Kökteki ASTER 30 m ESRI Grid (2.6 GB) — yerel DEM, depoya girmemeli.
# data/dem/aster30m/ kuralı bu yolu kapsamıyordu.
/aster30M/

# Kökteki ulusal 10 m DEM kopyası (23.5 GB, ERDAS .img ailesi) — yerel kaynak,
# depoya girmemeli. DEM_10M değişkeni burayı işaret eder (gis.py varsayılanı ROOT/10M/).
/10M/

# Excel açıkken bıraktığı kilit dosyaları
~$*

# Aylık CHELSA yığını (288 MB) — kalibrasyonun hız önbelleği, türetilmiş veri.
# tools/su_butcesi.py yoksa kaynaktan yeniden indirir.
data/yagis/_onbellek_aylik.npz

# Yerel çalışma verisi — depoya girmemeli (GitHub 100 MB üstü dosyayı reddeder).
# Data.db ~1.6 GB, Havzalar.rar ~1.8 GB, Havzalar/ ~6 GB.
/Data.db
/Havzalar/
*.rar
*.7z

# DSİ akım gözlem ağı KMZ'si (3739 AGİ, D02A001 biçimi) — yerel kaynak veri.
# Yağış tarafıyla ilgisi yok; agi.sqlite'ın eksik yağış alanlarını doldurmakta
# kullanılabilir ama şimdilik bağlanmadı.
/RASATLAR GÖZLEMAĞI*.kmz

# MGM istasyon Excel arşivi (1290 dosya, 105 MB) — yerel kaynak veri.
# Kullanılan özet data/stations/ ve data/tables/ içindedir.
# Klasör adı düz I ile yazılmış (DMI), noktalı İ ile değil — ikisi de yazılıyor
# ki elle oluşturulan kopya da tutulsun.
/DMI-tümü/
/DMİ-tümü/

# Node devDependencies — depoya girmemeli (eslint/vitest/prettier)
node_modules/

# Lavish Editor inceleme yüzeyleri — yerel, geçici
.lavish/
